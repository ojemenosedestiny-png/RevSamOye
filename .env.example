# Copy to .env.local for local development, and add the same keys in Render → Environment.

# Public URL of the site (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Admin panel (/admin) ──
# A long, unique password (16+ characters). Anyone with it can see confidential bookings.
ADMIN_PASSWORD=
# Random string used to sign admin sessions, e.g. from: openssl rand -hex 32  (Render can generate it)
ADMIN_SESSION_SECRET=

# ── Database + file storage (Supabase) ── bookings, newsletter, events, uploaded photos & video
# Project Settings → API. The service-role key is secret: server only, never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Largest upload allowed from the admin panel, in MB (Supabase free plan caps files at 50 MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ── Email (Resend) ── ministry notification + confirmation to the person
RESEND_API_KEY=
# A sender on a domain you've verified in Resend
EMAIL_FROM="Rev. Dr. Sam Oye <no-reply@samoyeglobal.org>"
# Inbox that receives new counseling requests
MINISTRY_EMAIL=hello@samoyeglobal.org

# ── Spam protection (Cloudflare Turnstile) ── optional; leave blank to disable
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
